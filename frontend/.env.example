# true  → sahte API (src/services/mockApi.js), backend gerekmez
# false → gerçek FastAPI (VITE_API_URL)
VITE_USE_MOCK_API=true
VITE_API_URL=http://localhost:8000

# Supabase → Project Settings → API
# Sadece anon / publishable key. service_role / secret key ASLA buraya konmaz.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
